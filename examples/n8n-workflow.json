{
  "name": "TikTok Gateway — welcome v1",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "tiktok-follower-gateway",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "tiktok-follower-gateway"
    },
    {
      "id": "follower-event",
      "name": "Follower event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Follower event",
              "leftValue": "={{ $json.body.schemaVersion === '1' && $json.body.type === 'follower.created' && typeof $json.body.eventId === 'string' && typeof $json.body.data.userId === 'string' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wait-before-welcome",
      "name": "Wait before welcome",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "configuration",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "url",
              "name": "gatewayUrl",
              "value": "http://tiktok-gateway:8080",
              "type": "string"
            },
            {
              "id": "sticker",
              "name": "stickerId",
              "value": "REPLACE_WITH_CATALOG_ID",
              "type": "string"
            },
            {
              "id": "text",
              "name": "text",
              "value": "Привет! Спасибо за подписку!",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "send-text",
      "name": "Send Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $('Configuration').first().json.gatewayUrl + '/v1/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Webhook').first().json.body.eventId + ':welcome-v1:text-1' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ recipientUserId: $('Webhook').first().json.body.data.userId, type: 'text', text: $('Configuration').first().json.text }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "wait-text",
      "name": "Wait Text",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "check-text",
      "name": "Check Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ $('Configuration').first().json.gatewayUrl + '/v1/operations/' + $('Send Text').first().json.operationId }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "text-succeeded",
      "name": "Text succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1620,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Text succeeded",
              "leftValue": "={{ $json.state === 'succeeded' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "text-pending",
      "name": "Text pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1620,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Text pending",
              "leftValue": "={{ ['queued','sending','verifying'].includes($json.state) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "text-failed",
      "name": "Text failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1840,
        280
      ],
      "parameters": {
        "errorMessage": "={{ 'TikTok text operation ' + $json.operationId + ': ' + $json.state + ' (' + ($json.reason || 'unknown state') + '). Inspect gateway; never retry with a new key.' }}"
      }
    },
    {
      "id": "send-sticker",
      "name": "Send Sticker",
      "type": "n8n-nodes-base.httpRequest",
