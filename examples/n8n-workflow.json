        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ recipientUserId: $('Webhook').first().json.body.data.userId, type: 'sticker', stickerId: $('Configuration').first().json.stickerId }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "wait-sticker",
      "name": "Wait Sticker",
